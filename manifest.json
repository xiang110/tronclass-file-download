{
  "manifest_version": 3,
  "name": "TronClass 教材連結助手",
  "version": "7.0.0",
  "description": "教材清單、附件引用、Network、PDF Viewer 與官方附件快捷按鈕",
  "content_scripts": [
    {
      "matches": [
        "https://elearn2.fju.edu.tw/*"
      ],
      "js": [
        "content.js",
        "attachment-buttons.js",
        "courseware-buttons.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "webRequest"
  ],
  "host_permissions": [
    "https://elearn2.fju.edu.tw/*",
    "https://mediaelearn2.fju.edu.tw/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
